# gayatrinursing.in (for Apache / cPanel hosting. Other servers ignore this file.)

# --- Force HTTPS and remove www ------------------------------------------
# Turn this on ONLY after the SSL certificate is active (https://gayatrinursing.in
# opens with a padlock). Remove the "#" from the 5 lines below.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml image/x-icon
</IfModule>

# --- Browser caching ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Types and basic security headers ----------------------------------------
AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset utf-8
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

Options -Indexes
